# Environment configuration
# Copy this to .env.des, .env.dev, or .env.prod and fill in values.
#
# Scripts automatically load the correct file:
#   npm run dev          -> loads .env.des  (local development)
#   npm run dev:hosted   -> loads .env.dev  (hosted dev environment)
#   npm run start:prod   -> loads .env.prod (production)

NODE_ENV="des"                  # des | dev | prod
DATABASE_URL="postgresql://user:password@localhost:5432/expense_tracker"
JWT_SECRET="your-secret-key"
PORT=3001
FRONTEND_URL="http://localhost:5173"
