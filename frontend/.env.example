# Frontend environment configuration
# Copy this to .env.des, .env.dev, or .env.prod and fill in values.
#
# Scripts automatically load the correct file via Vite's --mode flag:
#   npm run dev          -> loads .env.des  (local, uses Vite proxy)
#   npm run dev:hosted   -> loads .env.dev  (hosted dev)
#   npm run build:prod   -> loads .env.prod (production build)

VITE_API_URL=/api
